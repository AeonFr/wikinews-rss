---
import type { ArticlePage } from "../../model";
import Kicker from "./Kicker.astro";
import Title from "./Title.astro";

interface Props {
  page: Pick<ArticlePage, "title" | "day" | "crumbs" | "categories">;
}
const { page } = Astro.props;
---

<header>
  <Kicker day={page.day} crumbs={page.crumbs} categories={page.categories} />
  <Title>{page.title}</Title>
</header>
