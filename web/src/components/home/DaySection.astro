---
import { formatDay } from "../../data/days";
import type { HomeDay } from "../../model";
import BoxList from "./BoxList.astro";
import EntryList from "./EntryList.astro";
import { dayHeadingId } from "./layout";
import styles from "./DaySection.module.css";

interface Props {
  day: HomeDay;
}
const { day } = Astro.props;
const headingId = dayHeadingId(day.day);
// The rest of the news comes first, the clusters (boxes) last: each cluster's title ends the list before it and the next
// day's heading ends the last cluster. The order: portal entries with an image, tiles with an image, portal entries
// without, tiles without.
const withImage = <T extends { image: unknown }>(items: T[], yes: boolean) => items.filter((item) => (item.image !== null) === yes);
const lists = [
  { entries: withImage(day.portalEntries, true), size: "large" as const, label: "From the Current events portal" },
  { entries: withImage(day.tiles, true), size: "tile" as const, label: "Single stories" },
  { entries: withImage(day.portalEntries, false), size: "large" as const, label: "From the Current events portal" },
  { entries: withImage(day.tiles, false), size: "tile" as const, label: "Single stories" },
].filter((list) => list.entries.length > 0);
// The first of the day's lists sits right under the heading's rule: it must not add a line of its own.
const boxesFirst = lists.length === 0;
---

<section class={styles.day} aria-labelledby={headingId}>
  <h2 id={headingId} class={styles.heading}>
    <time datetime={day.day}>{formatDay(day.day)}</time>
  </h2>
  {
    lists.map((list, i) => (
      <div class:list={[styles.block, i === 0 && styles.first]}>
        <EntryList entries={list.entries} size={list.size} label={list.label} first={i === 0} showLabels={list.size === "tile"} />
      </div>
    ))
  }
  {
    day.boxes.length > 0 && (
      <div class:list={[styles.block, boxesFirst && styles.first]}>
        <BoxList boxes={day.boxes} first={boxesFirst} />
      </div>
    )
  }
</section>
